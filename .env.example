# From Supabase: Project Settings > API. The anon key is safe in the browser because every
# table denies it; never put the service role key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only for scripts/create-auth-users.mjs (development seed accounts). Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
SEED_DEFAULT_PASSWORD=

# Only for scripts/import-mysql-dump.mjs, which also needs the service role key above.
# From Supabase: Project Settings > Database, the connection string.
SUPABASE_DB_URL=
